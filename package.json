{
  "name": "@columbia-libraries/cul-toolkit",
  "version": "5.3.0",
  "description": "CUL customized Bootstrap 5 with Vite! Intended only for CUL projects and therefore unsupported.",
  "type": "module",
  "main": "dist/bundles/cul-menu.bundle.js",
  "module": "dist/bundles/cul-menu.bundle.es.js",
  "scripts": {
    "start": "vite",
    "build": "vite build --config vite.config.js && vite build --config vite.bundle.config.js && node scripts/copy-setup.js",
    "dev": "vite --config vite.config.js",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/assets",
    "dist/bundles",
    "dist/js",
    "dist/setup.js",
    "dist/setup.css",
    "src/scss"
  ],
  "keywords": [
    "cul"
  ],
  "author": "https://github.com/cul/cul-toolkit/graphs/contributors",
  "repository": "https://github.com/cul/cul-toolkit",
  "license": "ISC",
  "exports": {
    ".": {
      "import": "./dist/bundles/cul-menu.bundle.es.js",
      "require": "./dist/bundles/cul-menu.bundle.js"
    },
    "./setup": {
      "import": "./dist/setup.js",
      "require": "./dist/setup.js"
    },
    "./styles": {
      "import": "./dist/setup.css",
      "require": "./dist/setup.css"
    },
    "./dist/assets/*": "./dist/assets/*",
    "./dist/bundles/*": "./dist/bundles/*",
    "./dist/js/*": "./dist/js/*",
    "./src/scss/_variables": "./src/scss/_variables.scss",
    "./src/scss/_cul": "./src/scss/_cul.scss",
    "./src/scss/_sidebars": "./src/scss/_sidebars.scss"
  },
  "devDependencies": {
    "cssnano": "^7.1.2",
    "postcss": "^8.5.6",
    "sass": "^1.83.0",
    "vite": "^6.4.1",
    "vite-plugin-handlebars": "^2.0.0"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3"
  }
}
